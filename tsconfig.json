{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "types": ["node", "jest"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["testing/typescript/**/*.ts"],
  "exclude": ["node_modules", "cdk", "frontend"]
}
