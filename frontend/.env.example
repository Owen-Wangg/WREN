# WREN frontend build-time configuration.
# Copy to `.env.local` and fill in per environment. Never commit a real `.env`.
# Only VITE_-prefixed variables are exposed to the client bundle.

# The single application display-name value (Requirement 53.2). Rebranding the
# UI is changing this one value — no code changes required.
VITE_APP_NAME="Writing Coach"

# Deployment environment name; namespaces React Query cache keys.
VITE_ENVIRONMENT="local"

# REST API base URL (API Gateway stage).
VITE_API_BASE_URL="http://localhost:3000"

# Talk to the real backend + enforce Cognito auth and role-guarded routes.
# Leave "false" (or unset) for local dev: the app runs against the in-memory
# mock with no login wall. Set to "true" once the backend + Cognito are deployed
# and the Cognito vars below are filled in.
VITE_USE_LIVE_API="false"

# Cognito configuration. Required when VITE_USE_LIVE_API="true".
VITE_COGNITO_USER_POOL_ID=""
VITE_COGNITO_CLIENT_ID=""
VITE_AWS_REGION="ca-central-1"

# Optional exact email hostnames allowed for new sign-ups (comma-separated).
# UX hint only: unset or empty skips the form check; the deployed Cognito
# PreSignUp trigger decides (and denies everyone when its list is empty).
# Subdomains are not implied: `ubc.ca`
# does not allow `law.ubc.ca`. Must match the deployed Cognito allowlist.
# VITE_ALLOWED_EMAIL_DOMAINS="ubc.ca"
