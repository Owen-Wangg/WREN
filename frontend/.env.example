# WREN frontend build-time configuration.
# Copy to `.env.local` and fill in per environment. Never commit a real `.env`.
# Only VITE_-prefixed variables are exposed to the client bundle.

# The single application display-name value (Requirement 53.2). Rebranding the
# UI is changing this one value — no code changes required.
VITE_APP_NAME="Writing Coach"

# Deployment environment name; namespaces React Query cache keys.
VITE_ENVIRONMENT="local"

# REST API base URL (API Gateway stage).
VITE_API_BASE_URL="http://localhost:3000"

# Cognito configuration (auth wiring lands in a later Track B task).
VITE_COGNITO_USER_POOL_ID=""
VITE_COGNITO_CLIENT_ID=""
VITE_AWS_REGION="ca-central-1"
